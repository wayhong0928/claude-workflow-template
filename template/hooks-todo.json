{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/todo/todo_core.py", "render"],
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/todo/todo_lint.py"],
          "timeout": 30
        }
      ]
    }
  ]
}
